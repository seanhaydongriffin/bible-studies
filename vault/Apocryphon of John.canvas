{
	"nodes":[
		{
			"id":"dad7d83ec73db07d",
			"type":"text",
			"text":"Apocryphon of John",
			"styleAttributes":{"textAlign":"center"},
			"x":-80,
			"y":3065,
			"width":280,
			"height":60
		},
		{"id":"c62db137b71db10f","type":"link","url":"https://youtu.be/22kxcbN8B_A?si=Z72PV2VwvnUF8N5F","x":-240,"y":3275,"width":400,"height":120},
		{
			"id":"3bf9512856f2552c",
			"type":"text",
			"text":"**Source:** Gnostic (Nag Hammadi)\n**Lens:** Academic history (Esoterica)",
			"styleAttributes":{"border":"invisible","shape":"pill","textAlign":"center"},
			"x":-80,
			"y":3140,
			"width":280,
			"height":60,
			"color":"6"
		},
		{
			"id":"683066cdb7c1282f",
			"type":"text",
			"text":"**Notes:**\nActs like a continuation of the Gospel of John (New Testament)",
			"styleAttributes":{},
			"x":-360,
			"y":3490,
			"width":520,
			"height":60
		},
		{
			"id":"f2aa4d967e3bc6b1",
			"type":"text",
			"text":"Yaldabaoth cuts into Adam's body to extract Epinoia",
			"styleAttributes":{},
			"x":680,
			"y":3145,
			"width":427,
			"height":60
		},
		{
			"id":"0f0357dd60989ce6",
			"type":"text",
			"text":"Eve as a physical mirror of the divine Epinoia",
			"styleAttributes":{},
			"x":680,
			"y":3287,
			"width":427,
			"height":60
		},
		{
			"id":"817e779d828f255c",
			"type":"text",
			"text":"Apocryphon",
			"styleAttributes":{"textAlign":"center"},
			"x":680,
			"y":3490,
			"width":140,
			"height":60
		},
		{
			"id":"15561a21b708114a",
			"type":"text",
			"text":"Not a fall from grace, but the start of liberation back to the Pleroma",
			"styleAttributes":{},
			"x":680,
			"y":3580,
			"width":460,
			"height":60
		},
		{
			"id":"07337f8ef1e4da80",
			"type":"text",
			"text":"The 'tree of life' in the garden is the archons' bitter counterfeit *(from the text)*",
			"styleAttributes":{},
			"x":680,
			"y":3670,
			"width":460,
			"height":60
		},
		{
			"id":"bc409f63fd43854d",
			"type":"text",
			"text":"Yaldabaoth assaults Eve, producing two demonic rulers of the body (roughly **Cain** and **Abel**)",
			"styleAttributes":{},
			"x":680,
			"y":3790,
			"width":460,
			"height":70
		},
		{
			"id":"9ae65f1f01504c62",
			"type":"text",
			"text":"Adam and Life produce a son: **Seth**",
			"styleAttributes":{},
			"x":680,
			"y":3935,
			"width":320,
			"height":60
		},
		{
			"id":"2b2a4f9c9258b0e1",
			"type":"text",
			"text":"Good news ('gospel')",
			"styleAttributes":{"textAlign":"center"},
			"x":680,
			"y":4155,
			"width":200,
			"height":60
		},
		{
			"id":"148e5feb68e10c19",
			"type":"text",
			"text":"Those condemned",
			"styleAttributes":{},
			"x":680,
			"y":4255,
			"width":200,
			"height":60
		},
		{
			"id":"5713ebb2c8dcf011",
			"type":"text",
			"text":"the Nephilim",
			"styleAttributes":{"textAlign":"center"},
			"x":680,
			"y":4827,
			"width":140,
			"height":60
		},
		{
			"id":"b7e22bdfa6e5264c",
			"type":"text",
			"text":"Demonic beings that mate with human women.",
			"styleAttributes":{},
			"x":860,
			"y":4827,
			"width":460,
			"height":60
		},
		{
			"id":"4e7de779bfd15ef5",
			"type":"text",
			"text":"Abrupt break in the text; possibly an earlier document attached to the end",
			"styleAttributes":{},
			"x":680,
			"y":4975,
			"width":560,
			"height":60
		},
		{
			"id":"b4b424f093a429a2",
			"type":"text",
			"text":"Pronoia (Providence) descends three times into the chaotic abyss",
			"styleAttributes":{},
			"x":680,
			"y":5080,
			"width":560,
			"height":60
		},
		{
			"id":"5588647df416b9ee",
			"type":"text",
			"text":"Hymn of Pronoia",
			"styleAttributes":{},
			"x":320,
			"y":5035,
			"width":173,
			"height":60
		},
		{
			"id":"b17cb3bc495085bc",
			"type":"text",
			"text":"Notes",
			"styleAttributes":{},
			"x":320,
			"y":5295,
			"width":87,
			"height":60
		},
		{
			"id":"33a5937bdc2016bb",
			"type":"text",
			"text":"Cards marked *(from the text)* add detail from the Apocryphon itself, not from the video",
			"styleAttributes":{},
			"x":680,
			"y":5230,
			"width":460,
			"height":65
		},
		{
			"id":"4a68b3507dc0b4b3",
			"type":"text",
			"text":"The video stresses this is not the only form of the Gnostic myth",
			"styleAttributes":{},
			"x":680,
			"y":5335,
			"width":460,
			"height":75
		},
		{
			"id":"f92c386d36c4a949",
			"type":"text",
			"text":"Fate",
			"styleAttributes":{"textAlign":"center"},
			"x":680,
			"y":4635,
			"width":100,
			"height":60
		},
		{
			"id":"fd8f6e15f6cd6f0b",
			"type":"text",
			"text":"Imposed on humanity, but resistible through spiritual powers",
			"styleAttributes":{},
			"x":860,
			"y":4635,
			"width":460,
			"height":60
		},
		{
			"id":"33fba9a8b99966b4",
			"type":"text",
			"text":"Yaldabaoth's further attacks",
			"styleAttributes":{},
			"x":320,
			"y":4735,
			"width":240,
			"height":60
		},
		{
			"id":"0de0f5c894275bf2",
			"type":"text",
			"text":"Flood",
			"styleAttributes":{"textAlign":"center"},
			"x":680,
			"y":4735,
			"width":100,
			"height":60
		},
		{
			"id":"985567859c9f3637",
			"type":"text",
			"text":"To destroy Seth's line; the luminous Epinoia warns Noah",
			"styleAttributes":{},
			"x":860,
			"y":4735,
			"width":460,
			"height":60
		},
		{
			"id":"7a6ea90184d4552f",
			"type":"text",
			"text":"Challenges the stereotype of Gnosticism as pessimistic",
			"styleAttributes":{},
			"x":680,
			"y":4367,
			"width":560,
			"height":60
		},
		{
			"id":"b4062cbf33c2295a",
			"type":"text",
			"text":"Those held by the 'counterfeit spirit' are reborn until they awaken *(from the text)*",
			"styleAttributes":{},
			"x":680,
			"y":4487,
			"width":560,
			"height":60
		},
		{
			"id":"f465fd21378fd955",
			"type":"text",
			"text":"John's question: \nfate of humanity",
			"styleAttributes":{},
			"x":320,
			"y":4315,
			"width":220,
			"height":60
		},
		{
			"id":"6314362c5bf73ef7",
			"type":"text",
			"text":"Seth and the Sethian line",
			"styleAttributes":{},
			"x":320,
			"y":3935,
			"width":220,
			"height":60
		},
		{
			"id":"fface898b738a032",
			"type":"text",
			"text":"**Eve**",
			"styleAttributes":{},
			"x":320,
			"y":3227,
			"width":80,
			"height":60
		},
		{
			"id":"b0f97b655293c3cf",
			"type":"text",
			"text":"Tree of Knowledge (reversed)",
			"styleAttributes":{},
			"x":320,
			"y":3535,
			"width":254,
			"height":60
		},
		{
			"id":"490d5740920f48ac",
			"type":"text",
			"text":"After the crucifixion, John is mocked at the Temple by a Pharisee and withdraws in grief *(from the text)*",
			"styleAttributes":{},
			"x":720,
			"y":475,
			"width":460,
			"height":65
		},
		{
			"id":"3eee70d8b7d7f28f",
			"type":"text",
			"text":"Jesus (the Saviour) appears in shifting forms and reveals the secret teaching (Apocryphon) to John *(from the text)*",
			"styleAttributes":{},
			"x":720,
			"y":553,
			"width":460,
			"height":70
		},
		{
			"id":"d9e00b8ace2d2e04",
			"type":"text",
			"text":"**Transcendent Father**: utterly transcendent, 'alien' God, described by negative theology (only by what it is not)",
			"styleAttributes":{},
			"x":910,
			"y":675,
			"width":460,
			"height":65
		},
		{
			"id":"1ee6564efd9d5ea4",
			"type":"text",
			"text":"**Barbelo**: arises from the Father knowing itself; the Mother. Meaning of the name is a mystery",
			"styleAttributes":{},
			"x":910,
			"y":760,
			"width":460,
			"height":60
		},
		{
			"id":"f0a2cd1f7bb3e925",
			"type":"text",
			"text":"Is formed by",
			"styleAttributes":{"textAlign":"center"},
			"x":640,
			"y":810,
			"width":160,
			"height":60
		},
		{
			"id":"129e2c5a26ae6391",
			"type":"text",
			"text":"**Autogenes / Divine Christ**: the self-created one, produced by the Father and Barbelo",
			"styleAttributes":{},
			"x":910,
			"y":840,
			"width":460,
			"height":60
		},
		{
			"id":"574dce5d5eeea640",
			"type":"text",
			"text":"Name possibly from Hebrew *yeled bohu*, 'child of chaos' (the video's suggestion)",
			"styleAttributes":{},
			"x":680,
			"y":1910,
			"width":540,
			"height":60
		},
		{
			"id":"d5fa4232a4f7f942",
			"type":"text",
			"text":"Hideous, nightmarish; also called Saklas ('fool') and Samael ('blind god') *(from the text)*",
			"styleAttributes":{},
			"x":680,
			"y":1995,
			"width":540,
			"height":60
		},
		{
			"id":"d330247dcd870f3f",
			"type":"text",
			"text":"Holds some divine power",
			"styleAttributes":{},
			"x":680,
			"y":2075,
			"width":540,
			"height":60
		},
		{
			"id":"2eb5f4378c73d6e0",
			"type":"text",
			"text":"Has a vague memory of the Pleroma",
			"styleAttributes":{},
			"x":680,
			"y":2155,
			"width":540,
			"height":60
		},
		{
			"id":"33fcb1ed466b79d7",
			"type":"text",
			"text":"Creates a 'micro-Pleroma': \nan inverted copy of the divine world",
			"styleAttributes":{},
			"x":680,
			"y":2232,
			"width":300,
			"height":60
		},
		{
			"id":"d6fa46fd22a6dc13",
			"type":"text",
			"text":"Populates it with demonic beings, including the **archons**, identified with the celestial bodies",
			"styleAttributes":{},
			"x":1040,
			"y":2232,
			"width":380,
			"height":60
		},
		{
			"id":"05500939ddad661e",
			"type":"text",
			"text":"**Syzygies**: paired semi-divine emanations, attending Barbelo or Christ",
			"styleAttributes":{},
			"x":910,
			"y":927,
			"width":460,
			"height":65
		},
		{
			"id":"306f5de699965ae7",
			"type":"text",
			"text":"is populated with\n(devine beings)",
			"styleAttributes":{},
			"x":640,
			"y":1070,
			"width":180,
			"height":60
		},
		{
			"id":"40ebb78cbb32b312",
			"type":"text",
			"text":"Four Luminaries (Harmozel, Oroiael, Daveithai, Eleleth) hold twelve aeons; Sophia falls under Eleleth *(from the text)*",
			"styleAttributes":{},
			"x":910,
			"y":1100,
			"width":460,
			"height":75
		},
		{
			"id":"578ccd934a4c9be7",
			"type":"text",
			"text":"**Aeons**: divine beings that populate the fullness. \nThe last produced is Sophia",
			"styleAttributes":{},
			"x":910,
			"y":1010,
			"width":460,
			"height":60
		},
		{
			"id":"6f7cc6a9bdd7f53a",
			"type":"text",
			"text":"Sophia (Wisdom) seeks to emulate the Father and create on her own",
			"styleAttributes":{},
			"x":680,
			"y":1275,
			"width":540,
			"height":60
		},
		{
			"id":"716cbfbb2600b5b1",
			"type":"text",
			"text":"Creates without the consent of her partner aeon: a cosmic disaster",
			"styleAttributes":{},
			"x":680,
			"y":1365,
			"width":540,
			"height":60
		},
		{
			"id":"1e8ca125f88e802b",
			"type":"text",
			"text":"From this unbalanced desire emerges Yaldabaoth, whom she expels from the Pleroma",
			"styleAttributes":{},
			"x":680,
			"y":1455,
			"width":540,
			"height":60
		},
		{
			"id":"bd78d653a92b6b08",
			"type":"text",
			"text":"She repents, and is placed in the ninth heaven until her deficiency is corrected *(from the text)*",
			"styleAttributes":{},
			"x":680,
			"y":1555,
			"width":540,
			"height":60
		},
		{
			"id":"84dbd10191cd423a",
			"type":"text",
			"text":"**Key move:** the God of Genesis (Yahweh) IS Yaldabaoth",
			"styleAttributes":{},
			"x":680,
			"y":2315,
			"width":440,
			"height":60
		},
		{
			"id":"7faa8247c0f3df42",
			"type":"text",
			"text":"Yaldabaoth boasts: 'I am a jealous God, there is none other'",
			"styleAttributes":{},
			"x":680,
			"y":2435,
			"width":540,
			"height":60
		},
		{
			"id":"84a1b3203427afbe",
			"type":"text",
			"text":"The divine primordial Human Being is reflected in the chaotic waters",
			"styleAttributes":{},
			"x":680,
			"y":2515,
			"width":540,
			"height":60
		},
		{
			"id":"91868dd1255e54a0",
			"type":"text",
			"text":"Yaldabaoth and his demons make a psychic copy (of that Adam / Human Being), but cannot animate it",
			"styleAttributes":{},
			"x":680,
			"y":2595,
			"width":540,
			"height":65
		},
		{
			"id":"4ce3d5c42993279d",
			"type":"text",
			"text":"Barbelo and the Father trick Yaldabaoth into breathing his latent divinity into Adam",
			"styleAttributes":{},
			"x":680,
			"y":2680,
			"width":540,
			"height":60
		},
		{
			"id":"9d05fbb32a91218d",
			"type":"text",
			"text":"Corrected from the Pleroma: \nthe (divine) Human Being exists",
			"styleAttributes":{},
			"x":1260,
			"y":2435,
			"width":300,
			"height":60
		},
		{
			"id":"3027e222ee988acb",
			"type":"text",
			"text":"Divine power (originally from Sophia) passes into the human being",
			"styleAttributes":{},
			"x":1260,
			"y":2680,
			"width":300,
			"height":60
		},
		{
			"id":"f39f799ce87b6140",
			"type":"text",
			"text":"Meaning 'delight': a trap of bodily pleasure",
			"styleAttributes":{},
			"x":1400,
			"y":2795,
			"width":340,
			"height":60
		},
		{
			"id":"a4313b5d54181779",
			"type":"text",
			"text":"Eden",
			"styleAttributes":{"textAlign":"center"},
			"x":1180,
			"y":2855,
			"width":100,
			"height":60
		},
		{
			"id":"85e9ff1f7a9e6f56",
			"type":"text",
			"text":"Is a prison, not a paradise",
			"styleAttributes":{},
			"x":1400,
			"y":2885,
			"width":340,
			"height":60
		},
		{
			"id":"31203060be6fd2cc",
			"type":"text",
			"text":"Adam is clothed in a material body: a 'tomb' and chain of forgetfulness *(from the text)*",
			"styleAttributes":{},
			"x":1180,
			"y":2965,
			"width":460,
			"height":60
		},
		{
			"id":"a6a4e5310dca5e16",
			"type":"text",
			"text":"Yaldabaoth realises the trick and casts Adam into the depths of matter",
			"styleAttributes":{},
			"x":680,
			"y":2855,
			"width":460,
			"height":60
		},
		{
			"id":"3d053977df283b7b",
			"type":"text",
			"text":"The Father takes pity (on the Human Being) and places inside Adam an **Epinoia** (the seed of salvation)",
			"styleAttributes":{},
			"x":680,
			"y":2965,
			"width":460,
			"height":60
		},
		{
			"id":"1de812bb1988f5a7",
			"type":"text",
			"text":"Genesis",
			"styleAttributes":{"textAlign":"center"},
			"x":680,
			"y":3400,
			"width":140,
			"height":60
		},
		{
			"id":"8709618592955c4d",
			"type":"text",
			"text":"Eating = rebellion against God and condemnation",
			"styleAttributes":{},
			"x":860,
			"y":3400,
			"width":380,
			"height":60
		},
		{
			"id":"22ef690ab3493146",
			"type":"text",
			"text":"By disobeying Yaldabaoth (Yahweh) they gain understanding of their plight",
			"styleAttributes":{},
			"x":860,
			"y":3490,
			"width":380,
			"height":60
		},
		{
			"id":"8bd7620c705c95d1",
			"type":"text",
			"text":"But Epinoia has already fled back to the divine realm",
			"styleAttributes":{},
			"x":1189,
			"y":3095,
			"width":451,
			"height":60
		},
		{
			"id":"905c0bcda6a03664",
			"type":"text",
			"text":"Creates a physical double in the form of **Life** (Chava / **Eve**)",
			"styleAttributes":{},
			"x":1189,
			"y":3197,
			"width":460,
			"height":60
		},
		{
			"id":"f77fbb4018fb4c75",
			"type":"text",
			"text":"Seth = spiritual ancestor of all who gain knowledge; the line through which Epinoia flows",
			"styleAttributes":{},
			"x":1080,
			"y":3895,
			"width":460,
			"height":60
		},
		{
			"id":"3a0acc01abc5a351",
			"type":"text",
			"text":"Hence the name **Sethian Gnosticism**",
			"styleAttributes":{},
			"x":1080,
			"y":3985,
			"width":320,
			"height":60
		},
		{
			"id":"0c39a27a2e7d152c",
			"type":"text",
			"text":"Almost all of humanity will eventually reach saving knowledge",
			"styleAttributes":{},
			"x":940,
			"y":4153,
			"width":560,
			"height":65
		},
		{
			"id":"5d2ce21d06a9b9db",
			"type":"text",
			"text":"Those who gain gnosis and then betray or abandon it",
			"styleAttributes":{},
			"x":940,
			"y":4255,
			"width":560,
			"height":60
		},
		{
			"id":"56bd5c33aca92dd6",
			"type":"text",
			"text":"Noah's people hidden in a luminous cloud, 'not as Moses said' *(from the text)*",
			"styleAttributes":{},
			"x":1360,
			"y":4735,
			"width":460,
			"height":60
		},
		{
			"id":"e4da9c6effb94321",
			"type":"text",
			"text":"Genesis 6; Book of the Watchers / 1 Enoch",
			"styleAttributes":{},
			"x":1360,
			"y":4827,
			"width":460,
			"height":60
		},
		{
			"id":"e8bd2551ebe4c63d",
			"type":"text",
			"text":"On the third descent she awakens humanity from ignorance",
			"styleAttributes":{},
			"x":1280,
			"y":5080,
			"width":480,
			"height":60
		},
		{
			"id":"c50b4211e1b67a8c",
			"type":"text",
			"text":"Inaugurates salvation with a **five-fold baptism**",
			"styleAttributes":{},
			"x":1820,
			"y":5080,
