			"width":360,
			"height":460
		},
		{
			"id":"b81211cea87c61ae",
			"type":"text",
			"text":"![[Pasted image 20261024183637.png]]",
			"styleAttributes":{},
			"x":8610,
			"y":-1340,
			"width":360,
			"height":460
		},
		{
			"id":"d9d1a23f7c71d5c9",
			"type":"text",
			"text":"![[Pasted image 20261024183807.png]]",
			"styleAttributes":{},
			"x":7940,
			"y":-780,
			"width":400,
			"height":400
		},
		{
			"id":"3ec8915fc7ddda8a",
			"type":"text",
			"text":"![[Pasted image 20261024183949.png]]",
			"styleAttributes":{},
			"x":8610,
			"y":-590,
			"width":400,
			"height":500
		},
		{
			"id":"a5d7b6bdc4e320be",
