			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":-340,
			"width":120,
			"height":60
		},
		{
			"id":"363808154de9279c",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":-250,
			"width":120,
			"height":60
		},
		{
			"id":"5866243b8f2f5603",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":-160,
			"width":120,
			"height":60
		},
		{
			"id":"67e14e53e168ea5f",
			"type":"text",
			"text":"**Belief**\nBeliefs within beliefs",
			"styleAttributes":{},
			"x":1640,
			"y":-60,
			"width":180,
			"height":60
		},
		{
			"id":"6942178f62b1e2f0",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1860,
			"y":-100,
			"width":120,
			"height":60
		},
		{
			"id":"ac80f390dddb253a",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1860,
			"y":-10,
			"width":120,
			"height":60
		},
		{
			"id":"6b915f3c058a092d",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1500,
			"y":-490,
			"width":120,
			"height":60
		},
		{
			"id":"65f2d6a04f52ef0a",
			"type":"text",
			"text":"**Accepting our thoughts as abject reality / truth.**",
			"styleAttributes":{},
			"x":1280,
			"y":-400,
			"width":260,
			"height":60
		},
		{
			"id":"1cd31d62ff4423f7",
			"type":"text",
			"text":"**\"I believe this...\"**\nA decision to accept thought as truth has been made.",
			"styleAttributes":{},
			"x":1280,
			"y":-280,
			"width":320,
			"height":100
		},
		{
			"id":"82a3a38564dbef2f",
			"type":"text",
			"text":"1",
			"styleAttributes":{},
			"x":1190,
			"y":-160,
			"width":60,
			"height":60
		},
		{
			"id":"b41ac89050de07b8",
			"type":"text",
			"text":"\"Well ... (Christians) believe such and such, so, so do I.\"",
			"styleAttributes":{},
			"x":1640,
			"y":80,
			"width":280,
			"height":80
		},
		{
			"id":"4d2faac9f701c09e",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":280,
			"width":120,
			"height":60
		},
		{
			"id":"1465d050d749ff73",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":370,
			"width":120,
			"height":60
		},
		{
			"id":"446c0343b64876bd",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1800,
			"y":370,
			"width":120,
			"height":60
		},
		{
			"id":"a2bec13ffc9ffbe7",
			"type":"text",
			"text":"Personification of belief / personal identification",
			"styleAttributes":{},
			"x":1280,
			"y":200,
			"width":260,
			"height":60
		},
		{
			"id":"29b03a16e4dbb862",
			"type":"text",
			"text":"**\"I am this...\", \"I am a ... (Christian / Mormon / Catholic)\".**\nYou have attached your identity to a belief you have constructed.",
			"styleAttributes":{},
			"x":1280,
			"y":320,
			"width":320,
			"height":100
		},
		{
			"id":"8837238afd8958df",
			"type":"text",
			"text":"2",
			"styleAttributes":{},
			"x":1190,
			"y":480,
			"width":60,
			"height":60
		},
		{
			"id":"aaeac2d41a734aa2",
			"type":"text",
			"text":"Addition of beliefs that others have but you've never even considered",
			"styleAttributes":{},
			"x":1280,
			"y":80,
			"width":320,
			"height":80
		},
		{
			"id":"5e6926efab361d4a",
			"type":"text",
			"text":"Stages of belief formation",
			"styleAttributes":{},
			"x":840,
			"y":280,
			"width":260,
			"height":60
		},
		{
			"id":"a831544a35c25c7a",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":450,
			"width":120,
			"height":60
		},
		{
			"id":"87320c9c93367337",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1860,
			"y":500,
			"width":120,
			"height":60
		},
		{
			"id":"12bb7f4b68c1c67d",
			"type":"text",
			"text":"**Belief**\nBeliefs within beliefs",
			"styleAttributes":{},
			"x":1640,
			"y":540,
			"width":180,
			"height":60
		},
		{
			"id":"6ec517e31f0595bc",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1860,
			"y":590,
			"width":120,
			"height":60
		},
		{
			"id":"706630732c32b791",
			"type":"text",
			"text":"\"Well I'm a ... (Christian) so I believe such and such.\"",
			"styleAttributes":{},
			"x":1640,
			"y":680,
			"width":280,
			"height":60
		},
		{
			"id":"855fa935cea1bf52",
			"type":"text",
			"text":"Addition of beliefs that others have but you've not even considered",
			"styleAttributes":{},
			"x":1280,
			"y":680,
			"width":320,
			"height":60
		},
		{
			"id":"97757bcd77db4762",
			"type":"text",
			"text":"BE-LIE-F\n(like being a lie)",
			"styleAttributes":{},
			"x":1160,
			"y":780,
			"width":160,
			"height":60
		},
		{
			"id":"73e3ad37b6288404",
			"type":"text",
			"text":"A simple way to recognize each thought.",
			"styleAttributes":{},
			"x":1160,
			"y":880,
			"width":280,
			"height":60
		},
		{
			"id":"7c4c93dbd40fcb22",
			"type":"text",
			"text":"Formation of identity / Ego",
			"styleAttributes":{},
			"x":840,
			"y":780,
			"width":260,
			"height":60
		},
		{
			"id":"ebf75b52308faf33",
			"type":"text",
			"text":"Stop. Take note of your next thought. Just look at it without judgment.",
			"styleAttributes":{},
			"x":1160,
			"y":980,
			"width":280,
			"height":80
		},
		{
			"id":"812f63d57925119b",
			"type":"text",
			"text":"Simply say, \"Well that's interesting\".",
			"styleAttributes":{},
			"x":1160,
			"y":1080,
			"width":280,
			"height":60
		},
		{
			"id":"cb58ba77d814fe76",
			"type":"text",
			"text":"As we explore brand new information today, your mind is going to enter into a state of conflict",
			"styleAttributes":{},
			"x":1160,
			"y":1170,
			"width":320,
			"height":80
		},
		{
			"id":"36ed2fddcf1d921d",
			"type":"text",
			"text":"Rather, just say, well isn't that interesting.",
			"styleAttributes":{},
			"x":1980,
			"y":1180,
			"width":260,
			"height":60
		},
		{
			"id":"2c91244072b4caea",
			"type":"text",
			"text":"Already many Bible scholars / students of the text, have looked at these things",
			"styleAttributes":{},
			"x":1160,
			"y":1280,
			"width":320,
			"height":80
		},
		{
			"id":"a1a79fc9f97edb4e",
			"type":"text",
			"text":"So far no one has been able to to debunk these new discoveries in the Biblical text.",
			"styleAttributes":{},
			"x":1530,
			"y":1280,
			"width":390,
			"height":80
		},
		{
			"id":"78205038043ca299",
			"type":"text",
			"text":"Be aware of what your mind is doing. Don't allow your current belief constructs to classify everything as true or false",
			"styleAttributes":{},
			"x":1530,
			"y":1160,
			"width":390,
			"height":100
		},
		{
			"id":"50f2a910268c73a0",
			"type":"text",
			"text":"Recognition of thought",
			"styleAttributes":{},
			"x":840,
			"y":990,
			"width":260,
			"height":60
		},
		{
			"id":"531c3079cf8419a0",
			"type":"text",
			"text":"The mental conflict",
			"styleAttributes":{},
			"x":840,
			"y":1180,
			"width":260,
			"height":60
		},
		{
			"id":"bd61c8cdfcde7ca7",
			"type":"text",
			"text":"We're not talking about \"believing\" in your spouse, parents, children etc.",
			"styleAttributes":{},
			"x":1140,
			"y":-1010,
			"width":380,
			"height":70
		},
		{
			"id":"a8998e64f2ac377c",
			"type":"text",
			"text":"So BELIEVING in Yeshua, IS having faith, hope and trust in him and his promises.",
			"styleAttributes":{},
			"x":1140,
			"y":-880,
			"width":360,
			"height":60
		},
		{
			"id":"71e374735e7cd978",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1330,
			"y":-800,
			"width":120,
			"height":60
		},
		{
			"id":"59ac55dcc33ab598",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1160,
			"y":-760,
			"width":120,
			"height":60
		},
		{
			"id":"9287738c699593e7",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1330,
			"y":-720,
			"width":120,
			"height":60
		},
		{
			"id":"89cf78c2e6a85db0",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1500,
			"y":-720,
			"width":120,
			"height":60
		},
		{
			"id":"4cd88fd42b4ed260",
			"type":"text",
			"text":"Not Faith/Hope/Trust",
			"styleAttributes":{},
			"x":840,
