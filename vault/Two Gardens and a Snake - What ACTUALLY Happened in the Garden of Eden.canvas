			},
			"x":200,
			"y":260,
			"width":240,
			"height":60,
			"color":"3"
		},
		{
			"id":"8410a815b8d2c752",
			"type":"text",
			"text":"**The importance of Context**",
			"styleAttributes":{
				"shape":"pill",
				"textAlign":null,
				"border":"invisible"
			},
			"x":220,
			"y":-40,
			"width":240,
			"height":60,
			"color":"4"
		},
		{
			"id":"f036f3a862c5e0ce",
			"type":"text",
			"text":"**What really happened in the garden?**",
			"styleAttributes":{
				"shape":"pill",
				"textAlign":null,
				"border":"invisible"
			},
			"x":220,
			"y":200,
			"width":240,
			"height":60,
			"color":"4"
		},
		{
			"id":"54977b520bdc04fe",
			"type":"text",
			"text":"**The fruit through the ancient world**",
			"styleAttributes":{
				"shape":"pill",
				"textAlign":null,
