			"text":"![[Pasted image 20261024185717.png]]",
			"styleAttributes":{},
			"x":8120,
			"y":3540,
			"width":540,
			"height":400
		},
		{
			"id":"4b667cd12bbf0785",
			"type":"text",
			"text":"Actual bag",
			"styleAttributes":{},
			"x":7940,
			"y":3710,
			"width":140,
			"height":60
		},
		{
			"id":"872c6d582d8b71f9",
			"type":"text",
			"text":"Gobekli Tepe\nTurkey",
			"styleAttributes":{},
			"x":7940,
			"y":3260,
			"width":140,
			"height":60
		},
		{
			"id":"cada32b9ce804dfb",
