			"styleAttributes":{},
			"x":8210,
			"y":-2750,
			"width":300,
			"height":380
		},
		{
			"id":"233ec5d5865e3ad9",
			"type":"text",
			"text":"India / Hinduism",
			"styleAttributes":{},
			"x":7970,
			"y":-2390,
			"width":180,
			"height":60
		},
		{
			"id":"97764403f309ec8d",
			"type":"text",
			"text":"![[Pasted image 20261024183117.png]]",
			"styleAttributes":{},
			"x":8210,
			"y":-2360,
			"width":460,
			"height":320
		},
		{
			"id":"278f6f23e355f8d4",
			"type":"text",
			"text":"![[Pasted image 20261024183428.png]]",
			"styleAttributes":{},
			"x":8210,
			"y":-2020,
			"width":320,
			"height":380
		},
		{
			"id":"dcfcc0cb65476daa",
			"type":"text",
			"text":"![[Pasted image 20261024183529.png]]",
			"styleAttributes":{},
			"x":8610,
			"y":-1760,
			"width":440,
			"height":260
		},
		{
			"id":"e9ca83e9d375b53b",
			"type":"text",
			"text":"Fruit and handbags",
			"styleAttributes":{},
			"x":7970,
			"y":-1660,
			"width":200,
			"height":60
		},
		{
			"id":"8646e06c4e62302c",
			"type":"text",
			"text":"Sumarian gods![[Pasted image 20261024181025.png]]",
			"styleAttributes":{},
			"x":8210,
			"y":-3550,
			"width":400,
			"height":420
		},
		{
			"id":"cee8c49228badb29",
			"type":"text",
			"text":"Middle East",
			"styleAttributes":{},
			"x":7970,
			"y":-3160,
			"width":140,
			"height":60
		},
		{
			"id":"e6222a6e1fce24d9",
			"type":"text",
			"text":"arcadian / assyrian\n![[Pasted image 20261024182114.png]]",
			"styleAttributes":{},
			"x":8210,
			"y":-3100,
			"width":400,
			"height":310
		},
		{
			"id":"fc34dd1fcaec94bf",
			"type":"text",
			"text":"The tree of life",
			"styleAttributes":{},
			"x":7760,
			"y":-2230,
			"width":160,
			"height":60
		},
		{
			"id":"14e4e3f35eeb3e73",
			"type":"text",
			"text":"Handbags",
			"styleAttributes":{},
			"x":7760,
			"y":1320,
			"width":120,
			"height":60
		},
		{
			"id":"ec0a9a9ab036399e",
			"type":"text",
			"text":"The introduction of Yahweh",
			"styleAttributes":{},
			"x":9440,
			"y":90,
			"width":260,
			"height":60
		},
		{
			"id":"1d1199012407955c",
			"type":"text",
			"text":"The word God or Lord in the Bible is translated from several different words, mainly Elohim and YHWH. In this study we're going to use the transliteration of the actual Hebrew word that has been translated as God in the Garden of Eden story. That word is Yahweh.\n\nTransliteration means the English-sounding equivalent of the original word in the Hebrew.",
			"styleAttributes":{},
			"x":9740,
			"y":20,
			"width":600,
			"height":200
		},
		{
			"id":"4eebd83da8bfda7e",
			"type":"text",
			"text":"Used from Genesis 1:1 through 2:3",
			"styleAttributes":{},
			"x":10540,
			"y":-320,
			"width":220,
			"height":60
		},
		{
			"id":"673970328809e070",
			"type":"text",
			"text":"אֱלֹהִים",
			"styleAttributes":{"textAlign":"center"},
			"x":10540,
			"y":-20,
			"width":80,
			"height":60
		},
		{
			"id":"b82ff83e78dc0d95",
			"type":"text",
			"text":"God",
			"styleAttributes":{},
			"x":10800,
			"y":-620,
			"width":80,
			"height":60
		},
		{
			"id":"bdfcea51939004f9",
			"type":"text",
			"text":"Elohim is actually plural and most times ought to be translated as \"the gods\". We translate it as \"god\" most of the time, solely due to the Christian narrative of a monotheistic god being such a strong influence over translation.",
			"styleAttributes":{},
			"x":10960,
			"y":-520,
			"width":460,
			"height":160
		},
		{
			"id":"f9e2fa3141682e20",
			"type":"text",
			"text":"Psalm 82 is a good example of Elohim being translated both as god and gods in the same sentence.",
			"styleAttributes":{},
			"x":10960,
			"y":-330,
			"width":460,
			"height":80
		},
		{
			"id":"dd47198c6f02a41f",
			"type":"text",
			"text":"God (elohim) has taken his place in the divine council; in the midst of the gods (elohim) he holds judgment.",
			"styleAttributes":{},
			"x":10970,
			"y":-210,
			"width":440,
			"height":70
		},
		{
			"id":"2e60bb3a153020df",
			"type":"text",
			"text":"Psalm 82:1 ESV",
			"styleAttributes":{},
			"x":11460,
			"y":-205,
			"width":160,
			"height":60
		},
		{
			"id":"44c5e8133cdc502a",
			"type":"text",
			"text":"Gods",
			"styleAttributes":{},
			"x":10800,
			"y":-390,
			"width":100,
			"height":60
		},
		{
			"id":"51fd87a6d89322b9",
			"type":"text",
			"text":"Lord",
			"styleAttributes":{},
			"x":10800,
			"y":-120,
			"width":100,
			"height":60
		},
		{
			"id":"1b9958e28c6da9f2",
			"type":"text",
			"text":"יהוה",
			"styleAttributes":{},
			"x":10540,
			"y":340,
			"width":80,
			"height":60
		},
		{
			"id":"967bcd5264221da5",
			"type":"text",
			"text":"The tetragrammaton",
			"styleAttributes":{},
			"x":10660,
			"y":340,
			"width":220,
			"height":60
		},
		{
			"id":"d0fbaff15584c37d",
			"type":"text",
			"text":"Yahweh",
			"styleAttributes":{},
			"x":10860,
			"y":180,
			"width":110,
			"height":60
		},
		{
			"id":"e87f61dcc6eb4f33",
			"type":"text",
			"text":"Introduced from Genesis 2:4",
			"styleAttributes":{},
			"x":10540,
			"y":180,
			"width":260,
			"height":60
		},
		{
			"id":"404cab5b3cc9eada",
			"type":"text",
			"text":"Jehovah",
			"styleAttributes":{},
			"x":10860,
			"y":250,
			"width":110,
			"height":60
		},
		{
			"id":"29eb2f842cbc8ad6",
			"type":"text",
			"text":"God",
			"styleAttributes":{},
			"x":10860,
			"y":110,
			"width":110,
			"height":60
		},
		{
			"id":"c4d6513b92595cdb",
			"type":"text",
			"text":"YHWH",
			"styleAttributes":{},
			"x":10400,
			"y":250,
			"width":100,
			"height":60
		},
		{
			"id":"2cc36e4cbdfc8a42",
			"type":"text",
			"text":"Elohim",
			"styleAttributes":{},
			"x":10400,
			"y":-170,
			"width":100,
			"height":60
		},
		{
			"id":"dabf1961c6584799",
			"type":"text",
			"text":"The script ...",
			"styleAttributes":{},
			"x":11760,
			"y":90,
			"width":140,
			"height":60
		},
		{
			"id":"3f57d01a45c6738f",
			"type":"text",
			"text":"So she took some of the fruit and ate it. She also gave some to her husband, who was with her, and he ate it.",
			"styleAttributes":{},
			"x":12640,
			"y":-890,
			"width":360,
			"height":80
		},
		{
			"id":"47efad757dd586ac",
			"type":"text",
			"text":"Self-aware",
			"styleAttributes":{"textAlign":"center"},
			"x":13020,
			"y":-810,
			"width":120,
			"height":60
		},
		{
			"id":"bcdf6ffa378687eb",
			"type":"text",
			"text":"Conscious",
			"styleAttributes":{"textAlign":"center"},
			"x":13020,
			"y":-730,
			"width":120,
			"height":60
		},
		{
			"id":"ad766fc71fbf3966",
			"type":"text",
			"text":"Other words were used for this type of experience. They became...",
			"styleAttributes":{},
			"x":12660,
			"y":-700,
			"width":300,
			"height":60
		},
		{
			"id":"205aa5a1d7431eda",
			"type":"text",
			"text":"Awake",
			"styleAttributes":{"textAlign":"center"},
			"x":13020,
			"y":-650,
			"width":120,
			"height":60
		},
		{
			"id":"94a531e5e2f34e7d",
			"type":"text",
			"text":"Enlightened",
			"styleAttributes":{"textAlign":"center"},
			"x":13020,
			"y":-570,
			"width":120,
			"height":60
		},
		{
			"id":"3bd666d2fec33372",
			"type":"text",
			"text":"Snake",
			"styleAttributes":{},
			"x":12120,
			"y":-1035,
			"width":100,
			"height":60
		},
		{
			"id":"642388fa169806e4",
			"type":"text",
			"text":"Responds to woman",
			"styleAttributes":{},
			"x":12260,
			"y":-1035,
			"width":180,
			"height":60
		},
		{
			"id":"e41f788a3c17bf4e",
			"type":"text",
			"text":"The woman saw that the tree had fruit that was good to eat, nice to look at, and desirable for making someone wise.",
			"styleAttributes":{},
			"x":12260,
			"y":-895,
			"width":340,
			"height":90
		},
		{
			"id":"25aa8edf7be39396",
			"type":"text",
			"text":"Eve",
			"styleAttributes":{},
			"x":12120,
			"y":-880,
			"width":100,
			"height":60
		},
		{
			"id":"b64b9641cedad3e7",
			"type":"text",
			"text":"Then their eyes were opened, and they both realized that they were naked. They sewed fig leaves together and made clothes for themselves.",
			"styleAttributes":{},
			"x":12280,
			"y":-720,
			"width":360,
			"height":100
		},
		{
			"id":"4812725cecc94559",
			"type":"text",
			"text":"Adam & Eve",
			"styleAttributes":{},
			"x":12120,
			"y":-700,
			"width":140,
			"height":60
		},
		{
			"id":"1f9abe680e25eb7f",
			"type":"text",
			"text":"Yahweh",
			"styleAttributes":{},
			"x":12120,
			"y":-1410,
			"width":100,
			"height":60
		},
		{
			"id":"e3898561b1bd084d",
			"type":"text",
			"text":"Says to Adam",
			"styleAttributes":{},
			"x":12260,
			"y":-1410,
			"width":160,
			"height":60
		},
		{
			"id":"49a254491cca14db",
			"type":"text",
			"text":"Snake",
			"styleAttributes":{},
			"x":12120,
			"y":-1270,
			"width":100,
			"height":60
		},
		{
			"id":"07a6a1f157e1aeef",
			"type":"text",
			"text":"Says to the woman",
			"styleAttributes":{},
			"x":12260,
			"y":-1270,
			"width":180,
			"height":60
		},
		{
			"id":"48daa71c8dbd8aa5",
			"type":"text",
			"text":"Eve",
			"styleAttributes":{},
			"x":12120,
			"y":-1160,
			"width":100,
			"height":60
		},
		{
			"id":"d38209c468304b72",
			"type":"text",
			"text":"Answers the snake",
			"styleAttributes":{},
			"x":12260,
			"y":-1160,
			"width":180,
			"height":60
		},
		{
			"id":"e8004ad26d3b1182",
			"type":"text",
			"text":"You are free to eat from any tree in the garden. But you must never eat from the tree of the knowledge of good and evil because when you eat from it, you will certainly die.",
			"styleAttributes":{},
			"x":12460,
			"y":-1440,
			"width":460,
			"height":120
		},
		{
			"id":"814c6b7649ef5aea",
			"type":"text",
			"text":"Did Yahweh really say, 'You must never eat the fruit of any tree in the garden'?",
			"styleAttributes":{},
			"x":12480,
			"y":-1280,
			"width":440,
			"height":80
		},
		{
			"id":"c38a364d9e1e8bfe",
			"type":"text",
			"text":"We're allowed to eat the fruit from any tree in the garden except the tree in the middle of the garden. Yahweh said, 'You must never eat it or touch it. If you do, you will die!'",
			"styleAttributes":{},
			"x":12480,
			"y":-1190,
			"width":440,
			"height":120
		},
		{
			"id":"26e2e236dc33d907",
			"type":"text",
			"text":"Why does Yahweh not want Adam and Eve to have self-awareness, the ability to \"see\", and recognize good and evil?",
			"styleAttributes":{},
			"x":12960,
			"y":-1425,
			"width":480,
			"height":90
		},
		{
			"id":"003efea971e4201c",
			"type":"text",
			"text":"\"You certainly won't die!\" the snake told the woman. \"Yahweh knows that when you eat it your eyes will be opened. You'll be like Yahweh, knowing good and evil.\"",
			"styleAttributes":{},
			"x":12480,
			"y":-1050,
			"width":440,
			"height":90
		},
		{
			"id":"5768469a58e07c52",
			"type":"text",
			"text":"Tree of the knowledge of good and evil",
			"styleAttributes":{},
			"x":12960,
			"y":-1090,
			"width":340,
			"height":60
		},
		{
			"id":"15d86835443e48c9",
			"type":"text",
			"text":"Before they ate the fruit, Adam & Eve\nwere able to participate in conversations, but didn't have even the self-awareness to notice they were naked.",
			"styleAttributes":{},
			"x":12960,
			"y":-990,
			"width":460,
			"height":80
		},
		{
			"id":"3df707f52235ccdc",
			"type":"text",
			"text":"So Yahweh said to the snake, \"Because you have done this, You are cursed.\n\nI will make you and the woman hostile toward each other.\nI will make your descendants and her descendants hostile toward each other.\"",
			"styleAttributes":{},
			"x":12520,
			"y":670,
			"width":540,
			"height":160
		},
		{
			"id":"39413b782f4a3eaa",
			"type":"text",
			"text":"He said to the woman, \"I will increase your pain and your labor when you give birth to children.\n\nYou will long for your husband, and he will rule you.\"",
			"styleAttributes":{},
			"x":12520,
			"y":865,
			"width":540,
			"height":110
		},
		{
			"id":"c1fc6899009db13c",
			"type":"text",
			"text":"Curses Eve",
			"styleAttributes":{},
			"x":12300,
			"y":890,
			"width":180,
			"height":60
		},
		{
			"id":"71145a84508b8a3a",
			"type":"text",
			"text":"Then he said to the man, \"You listened to your wife and ate fruit from the tree, although I commanded you, 'You must never eat its fruit.'\n\nThe ground is cursed because of you. Through hard work you will eat food that comes from it every day of your life. The ground will grow thorns and thistles for you, and you will eat wild plants.\n\nBy the sweat of your brow, you will produce food to eat until you return to the ground, because you are taken from it. You are dust, and you will return to dust.\"",
			"styleAttributes":{},
			"x":12520,
			"y":1000,
			"width":540,
			"height":280
		},
		{
			"id":"45de0f6d204f8866",
			"type":"text",
			"text":"Curses Adam",
			"styleAttributes":{},
			"x":12300,
			"y":1110,
			"width":180,
			"height":60
		},
		{
			"id":"e8512bc4d5ef6121",
			"type":"text",
			"text":"Says to some others that Roman Universalists speculate is the Trinity. But it doesn't say that.",
			"styleAttributes":{},
			"x":12300,
			"y":1340,
			"width":360,
			"height":80
		},
		{
			"id":"af480e021543d7ab",
			"type":"text",
			"text":"\"The man has become **like one of us**, since he knows good and evil. He must not reach out and take the fruit of the tree of life and eat. Then he would live forever.\"",
			"styleAttributes":{},
			"x":12700,
			"y":1330,
			"width":460,
			"height":100
		},
		{
			"id":"e0485ee1f9a2f629",
			"type":"text",
			"text":"Who are the snake's descendants? Does Satan have descendants? Not according to Roman Universalism, or Christianity, he doesn't. How does that make any sense?",
			"styleAttributes":{},
			"x":13100,
			"y":700,
			"width":480,
			"height":100
		},
		{
			"id":"f992a7294ba45af1",
			"type":"text",
			"text":"Adam can no longer eat from the fruit in the garden, instead he has to eat from wild plants outside the garden.",
			"styleAttributes":{},
			"x":13100,
			"y":1090,
			"width":420,
			"height":100
		},
		{
			"id":"8f882f96aec213fb",
			"type":"text",
			"text":"It's crucial to realize that the snake didn't lie to Eve. The snake said they would become like Yahweh, and Yahweh then admits that very thing has occurred.",
			"styleAttributes":{},
			"x":13190,
			"y":1325,
			"width":440,
			"height":110
		},
		{
			"id":"8233369c3bb9e4b5",
			"type":"text",
			"text":"The only reason Adam & Eve died, was because Yahweh deprived them of the fruit of the tree of life.\n\nEating the fruit did not kill them as Yahweh told them it would. Rather, **he killed them** through **his** actions.",
			"styleAttributes":{},
			"x":13190,
			"y":1485,
			"width":460,
			"height":150
		},
		{
			"id":"ed322a15b8f35604",
			"type":"text",
			"text":"The story starts in the beginning of Genesis, the very first book in the Bible, but it ends in another garden within a city at the end of the last book of the Bible, Revelation.",
			"styleAttributes":{},
			"x":12560,
			"y":1690,
			"width":500,
			"height":120
		},
		{
			"id":"e41fb2d43756f3d3",
			"type":"text",
			"text":"So Yahweh sent the man out of the Garden of Eden to farm the ground from which the man had been formed. After he sent the man out, Yahweh placed angels and a flaming sword that turned in all directions east of the Garden of Eden. He placed them there to guard the way to the tree of life.",
			"styleAttributes":{},
			"x":12700,
			"y":1470,
			"width":460,
			"height":180
		},
		{
			"id":"f689947d03493298",
			"type":"text",
			"text":"**No longer will there be any curse**. The throne of God and of the Lamb will be in the city, and his servants will serve him. **They will see his face**, and his name will be on their foreheads.",
			"styleAttributes":{},
			"x":12860,
			"y":1900,
			"width":550,
			"height":100
		},
		{
			"id":"23d7b189f3f8bc2c",
			"type":"text",
			"text":"We are living between the gardens, between the trees.",
			"styleAttributes":{},
			"x":13100,
			"y":1710,
			"width":420,
			"height":80
		},
		{
			"id":"78fe85c2ef51df13",
			"type":"text",
			"text":"Revelation 22",
			"styleAttributes":{},
			"x":13470,
			"y":1920,
			"width":160,
			"height":60
		},
		{
			"id":"c73a3ee2ec9d122e",
			"type":"text",
			"text":"Act 5",
			"styleAttributes":{},
			"x":12000,
			"y":1920,
			"width":80,
			"height":60
		},
		{
			"id":"2706debc10edd8a9",
			"type":"text",
			"text":"That's what happened in the Garden of Eden. But the story doesn't end there.",
			"styleAttributes":{},
			"x":12140,
			"y":1710,
			"width":380,
			"height":80
		},
		{
			"id":"b32260de4e723092",
			"type":"text",
			"text":"Yeshua",
			"styleAttributes":{},
			"x":12140,
			"y":1920,
			"width":100,
			"height":60
		},
		{
			"id":"be58ec0b798c15e9",
			"type":"text",
			"text":"Then the angel showed me the river of the water of life, as clear as crystal, flowing from the throne of God and of the Lamb down the middle of the great street of the city.\n\nOn each side of the river stood the **tree of life**, bearing 12 crops of fruit, yielding its fruit every month. And the leaves of the tree are for the healing of the nations.",
			"styleAttributes":{},
			"x":12280,
			"y":1850,
			"width":530,
			"height":200
		},
		{
			"id":"88c4071009a10b08",
			"type":"text",
			"text":"Removes Adam & Eve from the garden",
			"styleAttributes":{},
			"x":12300,
			"y":1525,
			"width":360,
			"height":70
		},
		{
			"id":"54257110407e9e29",
			"type":"text",
			"text":"In the cool of the evening, the man and his wife heard Yahweh walking around in the garden. So they hid from Yahweh among the trees in the garden.",
			"styleAttributes":{},
			"x":12300,
			"y":-450,
			"width":480,
			"height":100
		},
		{
			"id":"4c767f14c5a96ca2",
			"type":"text",
			"text":"Yahweh",
			"styleAttributes":{},
			"x":12120,
			"y":-310,
			"width":140,
			"height":60
		},
		{
			"id":"8438ea2f8e3d4bf2",
			"type":"text",
			"text":"Yahweh called to the man and asked him, \"Where are you?\"",
			"styleAttributes":{},
			"x":12300,
			"y":-310,
			"width":480,
			"height":60
		},
		{
			"id":"fd620f593206f0d4",
			"type":"text",
			"text":"He answered, \"I heard you in the garden. I was afraid because I was naked, so I hid.\"",
			"styleAttributes":{},
			"x":12300,
			"y":-230,
			"width":480,
			"height":100
		},
		{
			"id":"b0d69afad77b8691",
			"type":"text",
			"text":"Adam",
			"styleAttributes":{},
			"x":12120,
			"y":-210,
			"width":140,
			"height":60
		},
		{
			"id":"05ab8a65f0944906",
			"type":"text",
			"text":"How can you hide from a non-physical God? and so here you can see my study called Yahweh, the Physical God.",
			"styleAttributes":{},
			"x":12820,
			"y":-450,
			"width":370,
			"height":100
		},
		{
			"id":"55fc1b8ecc26c986",
			"type":"text",
			"text":"Was Yahweh not all-knowing? How did he not know where they were if he is God?",
			"styleAttributes":{},
			"x":12820,
			"y":-310,
			"width":370,
			"height":60
		},
		{
			"id":"68528e2f7a1cdeef",
			"type":"text",
			"text":"So Yahweh was making sound / noise  walking around. Yahweh is a physical being.",
			"styleAttributes":{},
			"x":12820,
			"y":-220,
			"width":370,
			"height":80
		},
		{
			"id":"317ab19dd7a42374",
			"type":"text",
			"text":"So Adam passes the buck to Eve",
			"styleAttributes":{},
			"x":12820,
			"y":378,
			"width":280,
			"height":65
		},
		{
			"id":"837216c4bf6b5887",
			"type":"text",
			"text":"Yahweh is genuinely shocked. Not the response we'd expect from an all-knowing God.",
			"styleAttributes":{},
			"x":12820,
			"y":465,
			"width":370,
			"height":70
		},
		{
			"id":"dbcfad00ca6bded6",
			"type":"text",
			"text":"Passing the buck to the snake",
			"styleAttributes":{},
			"x":12820,
			"y":570,
			"width":370,
			"height":60
		},
		{
			"id":"8c3895b0bb1662da",
			"type":"text",
			"text":"The man answered, \"That woman, the one you gave me, gave me some fruit from the tree, and I ate it.\"",
			"styleAttributes":{},
			"x":12300,
			"y":370,
			"width":480,
			"height":80
		},
		{
			"id":"6476830e2b8ce04a",
			"type":"text",
			"text":"Then Yahweh asked the woman, \"What have you done?\"",
			"styleAttributes":{},
			"x":12300,
			"y":470,
			"width":480,
			"height":60
		},
		{
			"id":"394622e83502f25b",
			"type":"text",
			"text":"\"The snake deceived me, and I ate,\" the woman answered.",
			"styleAttributes":{},
			"x":12300,
			"y":570,
			"width":480,
			"height":60
		},
		{
			"id":"8fb7474c2283b96a",
			"type":"text",
			"text":"Curses the snake",
			"styleAttributes":{},
			"x":12300,
			"y":720,
			"width":180,
			"height":60
		},
		{
			"id":"336a669696915331",
			"type":"text",
			"text":"Adam & Eve",
			"styleAttributes":{},
			"x":12120,
			"y":-430,
			"width":140,
			"height":60
		},
		{
			"id":"c1ee0f8b468391a6",
			"type":"text",
			"text":"Act 3",
			"styleAttributes":{},
			"x":12000,
			"y":90,
			"width":80,
			"height":60
		},
		{
			"id":"8ee40668ca3954b0",
			"type":"text",
			"text":"Adam",
			"styleAttributes":{},
			"x":12120,
			"y":380,
			"width":140,
			"height":60
		},
		{
			"id":"108bd89e39e0292f",
			"type":"text",
			"text":"Yahweh",
			"styleAttributes":{},
			"x":12120,
			"y":470,
			"width":140,
			"height":60
		},
		{
			"id":"9c75bf09af615794",
			"type":"text",
			"text":"Eve",
			"styleAttributes":{},
			"x":12120,
			"y":570,
			"width":140,
			"height":60
		},
		{
			"id":"de8a0e84db02bde8",
			"type":"text",
			"text":"Act 2",
			"styleAttributes":{},
			"x":12000,
			"y":-1035,
			"width":80,
			"height":60
		},
		{
			"id":"13f46340b2186056",
			"type":"text",
			"text":"Act 1",
			"styleAttributes":{},
			"x":12000,
			"y":-1410,
			"width":80,
			"height":60
		},
		{
			"id":"176bdc26d2a9d6f9",
			"type":"text",
			"text":"Yahweh",
			"styleAttributes":{},
			"x":12120,
			"y":890,
			"width":140,
			"height":60
		},
		{
			"id":"6a9721fb3dd1f82c",
			"type":"text",
			"text":"Yahweh",
			"styleAttributes":{},
			"x":12140,
			"y":1440,
			"width":120,
			"height":60
		},
		{
			"id":"24714ba4d9bbc4bc",
			"type":"text",
			"text":"Act 4",
			"styleAttributes":{},
			"x":12000,
			"y":1560,
			"width":80,
			"height":60
		},
		{
			"id":"c725491c66d21a48",
			"type":"text",
			"text":"This means self-awareness can come from being TOLD things.",
			"styleAttributes":{},
			"x":13260,
			"y":-210,
			"width":360,
			"height":70
		},
		{
			"id":"eb0da1eca8a297d2",
			"type":"text",
			"text":"Hopefully that's happening right now. Hopefully this study is opening your eyes.",
			"styleAttributes":{},
			"x":13660,
			"y":-210,
			"width":420,
			"height":70
		},
		{
			"id":"b01371e2a66b9883",
			"type":"text",
			"text":"Why was Yahweh's first assumption that someone had told them, rather than they so rather than they had eaten the fruit?\n\nIt seems that there were several individuals he suspected may have told them. Did Yahweh have many enemies, not just the snake?",
			"styleAttributes":{},
			"x":13260,
			"y":191,
			"width":360,
			"height":220
		},
		{
			"id":"febb60bee1d7e026",
			"type":"text",
			"text":"Who could have told them they were naked?",
			"styleAttributes":{},
			"x":13260,
			"y":-14,
			"width":360,
			"height":70
		},
		{
			"id":"d2f85643ae541dd9",
			"type":"text",
			"text":"Did Yahweh think Yeshua or the Holy Spirit, the other members of the Christian trinity, may have told Adam & Eve they were naked?",
			"styleAttributes":{},
			"x":13660,
			"y":71,
			"width":420,
			"height":100
		},
		{
			"id":"6f4d9beaf61937fa",
			"type":"text",
			"text":"If the snake was the only other being there, the question would be moot.",
			"styleAttributes":{},
			"x":13660,
			"y":-9,
			"width":420,
			"height":60
		},
		{
			"id":"f90d86916367725e",
			"type":"text",
			"text":"We could spend a ton of time on these two questions alone. The implications of the first question, usually emitted or skipped over in any Bible study, cannot be ignored.",
			"styleAttributes":{},
			"x":12820,
			"y":-39,
			"width":370,
			"height":120
		},
		{
			"id":"aef474965bf256ab",
			"type":"text",
			"text":"Yahweh then asks two questions.\n1. \"who told you that you were naked?\n2. Did you eat fruit from the tree I commanded you not to eat from?\"",
			"styleAttributes":{},
			"x":12300,
			"y":-49,
			"width":480,
			"height":140
		},
		{
			"id":"d4f2517a5120697a",
			"type":"text",
			"text":"Yahweh",
			"styleAttributes":{},
			"x":12120,
			"y":-9,
			"width":140,
			"height":60
		},
		{
			"id":"5338a8b926bb975c",
			"type":"text",
			"text":"Who else was there to have been able to tell them?",
			"styleAttributes":{},
			"x":13660,
			"y":-109,
			"width":420,
			"height":70
		},
		{
			"id":"7335f5aaa31fa07e",
			"type":"text",
			"text":"What really happened in the garden?",
			"styleAttributes":{},
			"x":14360,
			"y":90,
			"width":260,
			"height":60
		},
		{
			"id":"197309e641a661a3",
			"type":"text",
			"text":"Pre-snake",
			"styleAttributes":{},
			"x":14960,
			"y":-1215,
			"width":120,
			"height":60
		},
		{
			"id":"d477cbc293e3197e",
			"type":"text",
			"text":"Access to all the trees except the tree of good and evil",
			"styleAttributes":{},
			"x":15140,
			"y":-1175,
			"width":260,
			"height":80
		},
		{
			"id":"c7b272909ea4970a",
			"type":"text",
			"text":"Biological immortality",
			"styleAttributes":{},
			"x":15140,
			"y":-1075,
			"width":200,
			"height":60
		},
		{
			"id":"ddbc6485e0bc8d5d",
			"type":"text",
			"text":"Man is in the garden",
			"styleAttributes":{},
			"x":15140,
			"y":-1395,
			"width":180,
			"height":60
		},
		{
			"id":"b863cce268c9b7fb",
			"type":"text",
			"text":"Yahweh didn't want Adam & Eve to be able to recognize good from evil.",
			"styleAttributes":{},
			"x":15380,
			"y":-1355,
			"width":320,
			"height":60
		},
		{
			"id":"5e6f952283cf07d2",
			"type":"text",
			"text":"No self-awareness",
			"styleAttributes":{},
			"x":15140,
			"y":-1295,
			"width":180,
			"height":60
		},
		{
			"id":"5b14275f71bfa7a3",
			"type":"text",
			"text":"Unlike Yahweh, who could",
			"styleAttributes":{},
			"x":15380,
			"y":-1275,
			"width":240,
			"height":60
		},
		{
			"id":"fa7c56fdb258c8bf",
			"type":"text",
			"text":"No curse",
			"styleAttributes":{},
			"x":15140,
			"y":-995,
			"width":100,
			"height":60
		},
		{
			"id":"864258e3d95ed537",
			"type":"text",
			"text":"Man is in the garden",
			"styleAttributes":{},
			"x":15140,
			"y":-895,
			"width":180,
			"height":60
		},
		{
			"id":"ac1b5dcba5b28b4c",
			"type":"text",
			"text":"Has self awareness",
			"styleAttributes":{},
			"x":15140,
			"y":-815,
			"width":180,
			"height":60
		},
		{
			"id":"0d65a84812c97885",
			"type":"text",
			"text":"Access to all the fruit in the garden",
			"styleAttributes":{},
			"x":15140,
			"y":-735,
			"width":260,
			"height":60
		},
		{
			"id":"ac5b39187a10ce3d",
			"type":"text",
			"text":"Biological immortality",
			"styleAttributes":{},
			"x":15140,
			"y":-655,
			"width":200,
			"height":60
		},
		{
			"id":"7e12c9e0f5fbed85",
			"type":"text",
			"text":"No curse",
			"styleAttributes":{},
			"x":15140,
			"y":-575,
			"width":130,
			"height":60
		},
		{
			"id":"511baabde62873da",
			"type":"text",
			"text":"Yahweh curses mankind and their relationship with the snake",
			"styleAttributes":{},
			"x":15220,
			"y":-475,
			"width":280,
			"height":80
		},
		{
			"id":"8968a7c8d1b0b709",
			"type":"text",
			"text":"Man is outside the garden",
			"styleAttributes":{},
			"x":15220,
			"y":-375,
			"width":260,
			"height":60
		},
		{
			"id":"bf0714b7868f5daf",
			"type":"text",
			"text":"Still has self-awareness",
			"styleAttributes":{},
			"x":15220,
			"y":-275,
			"width":220,
			"height":60
		},
		{
			"id":"f1ea4bd8d70341e2",
			"type":"text",
			"text":"No access to any of the fruit",
			"styleAttributes":{},
			"x":15220,
			"y":-195,
			"width":260,
			"height":60
		},
		{
			"id":"1f5986e848dbb893",
			"type":"text",
			"text":"No biological immortality",
			"styleAttributes":{},
			"x":15220,
			"y":-115,
			"width":260,
			"height":60
		},
		{
			"id":"455c66a599fa93b4",
			"type":"text",
			"text":"Man is in the garden",
			"styleAttributes":{},
			"x":15220,
			"y":5,
			"width":180,
			"height":60
		},
		{
			"id":"08547d69660b2b22",
			"type":"text",
			"text":"Has self awareness",
			"styleAttributes":{},
			"x":15220,
			"y":85,
			"width":180,
			"height":60
		},
		{
			"id":"d99a62606f6ca425",
			"type":"text",
			"text":"Access to all the fruit in the garden",
			"styleAttributes":{},
			"x":15220,
			"y":165,
			"width":240,
			"height":60
		},
		{
			"id":"ad83ead7a0dc946c",
			"type":"text",
			"text":"Biological immortality",
			"styleAttributes":{},
			"x":15220,
			"y":245,
			"width":200,
			"height":60
		},
		{
			"id":"17fdc3d8c6fe72a1",
			"type":"text",
			"text":"No curse",
			"styleAttributes":{},
			"x":15220,
			"y":325,
			"width":120,
			"height":60
		},
		{
			"id":"856cde896214e94d",
			"type":"text",
			"text":"What the snake wanted for man",
			"styleAttributes":{},
			"x":15180,
			"y":425,
			"width":280,
			"height":60
		},
		{
			"id":"831abba6b8f4386a",
			"type":"text",
			"text":"What Yahweh did to us",
			"styleAttributes":{},
			"x":15180,
			"y":505,
			"width":220,
			"height":60
		},
		{
			"id":"853ec65d06b5f0ad",
			"type":"text",
			"text":"What Yeshua then restores to us",
			"styleAttributes":{},
			"x":15180,
			"y":585,
			"width":280,
			"height":60
		},
		{
			"id":"af9d1a8fddf9c496",
			"type":"text",
			"text":"If the snake in the garden is Satan, one is forced to explain why Yeshua in Revelation 22 is restoring mankind back to the state\nthat Satan wanted for them in the garden, AND why the text calls it a restoration.",
			"styleAttributes":{},
			"x":14940,
			"y":825,
			"width":520,
			"height":120
		},
		{
			"id":"1a857bb136eaf61f",
			"type":"text",
			"text":"Cursed us to die by cutting off access to the fruit of the trees",
			"styleAttributes":{},
			"x":15440,
			"y":505,
			"width":300,
			"height":60
		},
		{
			"id":"7f83208b5775bf7f",
			"type":"text",
			"text":"Free access to the fruit of all the trees. To live forever.",
			"styleAttributes":{},
			"x":15500,
			"y":425,
			"width":360,
			"height":60
		},
		{
			"id":"1b3cf1cfb29c5715",
			"type":"text",
			"text":"Free access to the fruit of all the trees. To live forever.",
			"styleAttributes":{},
			"x":15500,
			"y":585,
			"width":360,
			"height":60
		},
		{
			"id":"4cb209153dfce9d9",
			"type":"text",
			"text":"Jesus, whom heaven must receive until the time for restoring all things about which God spoke.",
			"styleAttributes":{},
			"x":15500,
			"y":705,
			"width":360,
			"height":100
		},
		{
			"id":"50d28e77c9da2298",
			"type":"text",
			"text":"Acts 3",
			"styleAttributes":{},
			"x":15900,
			"y":725,
			"width":100,
			"height":60
		},
		{
			"id":"da309c45345d3469",
			"type":"text",
			"text":"The only **previous state** that Yeshua is **restoring**, is the one the **snake created** before Yahweh cursed them.",
			"styleAttributes":{},
			"x":15500,
			"y":825,
			"width":360,
			"height":120
		},
		{
			"id":"64fb79e7d18a9cb9",
			"type":"text",
			"text":"This is an obvious theological dilemma that you've never been taught, because it's immediately obvious that the snake simply can't be Satan, and the entire Christian narrative will collapse at its foundation of original sin and the snake being Satan, evaporates.",
			"styleAttributes":{},
			"x":15500,
			"y":965,
			"width":360,
			"height":200
		},
		{
			"id":"e3ead98b643dbc77",
			"type":"text",
			"text":"God, creator of mankind",
			"styleAttributes":{},
			"x":15380,
			"y":1205,
			"width":240,
			"height":60
		},
		{
			"id":"083aec87d8f7ebbc",
			"type":"text",
			"text":"Satan, a fallen angel",
			"styleAttributes":{},
			"x":15300,
			"y":1285,
			"width":200,
			"height":60
		},
		{
			"id":"4da9992e93b3be0e",
			"type":"text",
			"text":"Ruler of the Garden of Eden",
			"styleAttributes":{},
			"x":15310,
