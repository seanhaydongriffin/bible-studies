		},
		{
			"id":"4891f00b594273da",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":-340,
			"width":120,
			"height":60
		},
		{
			"id":"363808154de9279c",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":-250,
			"width":120,
			"height":60
		},
		{
			"id":"5866243b8f2f5603",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":-160,
			"width":120,
			"height":60
		},
		{
			"id":"67e14e53e168ea5f",
			"type":"text",
			"text":"**Belief**\nBeliefs within beliefs",
			"styleAttributes":{},
			"x":1640,
			"y":-60,
			"width":180,
			"height":60
		},
		{
			"id":"6942178f62b1e2f0",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1860,
			"y":-100,
			"width":120,
			"height":60
		},
		{
			"id":"ac80f390dddb253a",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1860,
			"y":-10,
			"width":120,
			"height":60
		},
		{
			"id":"6b915f3c058a092d",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1500,
			"y":-490,
			"width":120,
			"height":60
		},
		{
			"id":"65f2d6a04f52ef0a",
			"type":"text",
			"text":"**Accepting our thoughts as abject reality / truth.**",
			"styleAttributes":{},
			"x":1280,
			"y":-400,
			"width":260,
			"height":60
		},
		{
			"id":"1cd31d62ff4423f7",
			"type":"text",
			"text":"**\"I believe this...\"**\nA decision to accept thought as truth has been made.",
			"styleAttributes":{},
			"x":1280,
			"y":-280,
			"width":320,
			"height":100
		},
		{
			"id":"82a3a38564dbef2f",
			"type":"text",
			"text":"1",
			"styleAttributes":{},
			"x":1190,
			"y":-160,
			"width":60,
			"height":60
		},
		{
			"id":"b41ac89050de07b8",
			"type":"text",
			"text":"\"Well ... (Christians) believe such and such, so, so do I.\"",
			"styleAttributes":{},
			"x":1640,
			"y":80,
			"width":280,
			"height":80
		},
		{
			"id":"4d2faac9f701c09e",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":280,
			"width":120,
			"height":60
		},
		{
			"id":"1465d050d749ff73",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":370,
			"width":120,
			"height":60
		},
		{
			"id":"446c0343b64876bd",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1800,
			"y":370,
			"width":120,
			"height":60
		},
		{
			"id":"a2bec13ffc9ffbe7",
			"type":"text",
			"text":"Personification of belief / personal identification",
			"styleAttributes":{},
			"x":1280,
			"y":200,
			"width":260,
			"height":60
		},
		{
			"id":"29b03a16e4dbb862",
			"type":"text",
			"text":"**\"I am this...\", \"I am a ... (Christian / Mormon / Catholic)\".**\nYou have attached your identity to a belief you have constructed.",
			"styleAttributes":{},
			"x":1280,
			"y":320,
			"width":320,
			"height":100
		},
		{
			"id":"8837238afd8958df",
			"type":"text",
			"text":"2",
			"styleAttributes":{},
			"x":1190,
			"y":480,
			"width":60,
			"height":60
		},
		{
			"id":"aaeac2d41a734aa2",
			"type":"text",
			"text":"Addition of beliefs that others have but you've never even considered",
			"styleAttributes":{},
			"x":1280,
			"y":80,
			"width":320,
			"height":80
		},
		{
			"id":"5e6926efab361d4a",
			"type":"text",
			"text":"Stages of belief formation",
			"styleAttributes":{},
			"x":840,
			"y":280,
			"width":260,
			"height":60
		},
		{
			"id":"a831544a35c25c7a",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1640,
			"y":450,
			"width":120,
			"height":60
		},
		{
			"id":"87320c9c93367337",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1860,
			"y":500,
			"width":120,
			"height":60
		},
		{
			"id":"12bb7f4b68c1c67d",
			"type":"text",
			"text":"**Belief**\nBeliefs within beliefs",
			"styleAttributes":{},
			"x":1640,
			"y":540,
			"width":180,
			"height":60
		},
		{
			"id":"6ec517e31f0595bc",
			"type":"text",
			"text":"**Thought**",
			"styleAttributes":{},
			"x":1860,
			"y":590,
			"width":120,
			"height":60
		},
		{
			"id":"706630732c32b791",
			"type":"text",
			"text":"\"Well I'm a ... (Christian) so I believe such and such.\"",
			"styleAttributes":{},
			"x":1640,
			"y":680,
			"width":280,
			"height":60
		},
		{
			"id":"855fa935cea1bf52",
			"type":"text",
			"text":"Addition of beliefs that others have but you've not even considered",
			"styleAttributes":{},
			"x":1280,
			"y":680,
			"width":320,
			"height":60
		},
		{
			"id":"97757bcd77db4762",
			"type":"text",
			"text":"BE-LIE-F\n(like being a lie)",
			"styleAttributes":{},
			"x":1160,
			"y":780,
			"width":160,
			"height":60
		},
		{
			"id":"73e3ad37b6288404",
			"type":"text",
			"text":"A simple way to recognize each thought.",
			"styleAttributes":{},
			"x":1160,
			"y":880,
			"width":280,
			"height":60
		},
		{
			"id":"7c4c93dbd40fcb22",
			"type":"text",
			"text":"Formation of identity / Ego",
			"styleAttributes":{},
			"x":840,
			"y":780,
			"width":260,
			"height":60
		},
		{
			"id":"ebf75b52308faf33",
			"type":"text",
			"text":"Stop. Take note of your next thought. Just look at it without judgment.",
			"styleAttributes":{},
			"x":1160,
			"y":980,
			"width":280,
			"height":80
		},
		{
			"id":"812f63d57925119b",
			"type":"text",
			"text":"Simply say, \"Well that's interesting\".",
			"styleAttributes":{},
			"x":1160,
			"y":1080,
			"width":280,
			"height":60
		},
		{
			"id":"cb58ba77d814fe76",
			"type":"text",
			"text":"As we explore brand new information today, your mind is going to enter into a state of conflict",
			"styleAttributes":{},
			"x":1160,
			"y":1170,
			"width":320,
			"height":80
		},
		{
			"id":"36ed2fddcf1d921d",
			"type":"text",
			"text":"Rather, just say, well isn't that interesting.",
			"styleAttributes":{},
			"x":1980,
			"y":1180,
			"width":260,
			"height":60
		},
		{
			"id":"2c91244072b4caea",
			"type":"text",
			"text":"Already many Bible scholars / students of the text, have looked at these things",
			"styleAttributes":{},
			"x":1160,
			"y":1280,
			"width":320,
			"height":80
		},
		{
			"id":"a1a79fc9f97edb4e",
			"type":"text",
			"text":"So far no one has been able to to debunk these new discoveries in the Biblical text.",
			"styleAttributes":{},
			"x":1530,
			"y":1280,
			"width":390,
			"height":80
		},
		{
			"id":"78205038043ca299",
			"type":"text",
			"text":"Be aware of what your mind is doing. Don't allow your current belief constructs to classify everything as true or false",
			"styleAttributes":{},
			"x":1530,
			"y":1160,
			"width":390,
			"height":100
		},
		{
			"id":"50f2a910268c73a0",
			"type":"text",
			"text":"Recognition of thought",
			"styleAttributes":{},
			"x":840,
			"y":990,
			"width":260,
			"height":60
		},
		{
			"id":"531c3079cf8419a0",
			"type":"text",
			"text":"The mental conflict",
			"styleAttributes":{},
			"x":840,
			"y":1180,
			"width":260,
			"height":60
		},
		{
			"id":"bd61c8cdfcde7ca7",
			"type":"text",
			"text":"We're not talking about \"believing\" in your spouse, parents, children etc.",
			"styleAttributes":{},
			"x":1140,
			"y":-1010,
			"width":380,
			"height":70
		},
		{
			"id":"a8998e64f2ac377c",
			"type":"text",
			"text":"So BELIEVING in Yeshua, IS having faith, hope and trust in him and his promises.",
			"styleAttributes":{},
			"x":1140,
			"y":-880,
			"width":360,
			"height":60
		},
		{
			"id":"71e374735e7cd978",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1330,
			"y":-800,
			"width":120,
			"height":60
		},
		{
			"id":"59ac55dcc33ab598",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1160,
			"y":-760,
			"width":120,
			"height":60
		},
		{
			"id":"9287738c699593e7",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1330,
			"y":-720,
			"width":120,
			"height":60
		},
		{
			"id":"89cf78c2e6a85db0",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1500,
			"y":-720,
			"width":120,
			"height":60
		},
		{
			"id":"4cd88fd42b4ed260",
			"type":"text",
			"text":"Not Faith/Hope/Trust",
			"styleAttributes":{},
			"x":840,
			"y":-940,
			"width":260,
			"height":60
		},
		{
			"id":"c9928cfc6d6aa7a4",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1160,
			"y":-640,
			"width":120,
			"height":60
		},
		{
			"id":"643776406be10efe",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1500,
			"y":-610,
			"width":120,
			"height":60
		},
		{
			"id":"09c95c840bfaf9f8",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1160,
			"y":-550,
			"width":120,
			"height":60
		},
		{
			"id":"8805677ff1568075",
			"type":"text",
			"text":"Thought",
			"styleAttributes":{},
			"x":1330,
			"y":-550,
			"width":120,
			"height":60
		},
		{
			"id":"41df7bad7b8ffb3b",
			"type":"text",
			"text":"Free thought / Consideration",
			"styleAttributes":{},
			"x":840,
			"y":-640,
			"width":260,
			"height":60
		},
		{
			"id":"675c7e5ffeb965e4",
			"type":"text",
			"text":"The LORD God took the man and put him in the garden of Eden to work it and keep it. And the LORD God commanded the man, saying, \"You may surely eat of every tree of the garden, but of the tree of the knowledge of good and evil you shall not eat, for in the day that you eat of it you shall surely die.\"",
			"styleAttributes":{},
			"x":3100,
			"y":200,
			"width":640,
			"height":120
		},
		{
			"id":"1da5ccb2f38bfc24",
			"type":"text",
			"text":"Genesis 2:15-17",
			"styleAttributes":{},
			"x":3780,
			"y":225,
			"width":160,
			"height":70
		},
		{
			"id":"e5e17a457edd3e51",
			"type":"text",
			"text":"Then we have the incident with the snake",
			"styleAttributes":{},
			"x":3100,
			"y":340,
			"width":340,
			"height":60
		},
		{
			"id":"92cd031a499b2e5b",
			"type":"text",
			"text":"Genesis 2-3",
			"styleAttributes":{},
			"x":2920,
			"y":370,
			"width":130,
			"height":60
		},
		{
			"id":"0ae69534b0af22c6",
			"type":"text",
			"text":"Adam and Eve eat the fruit they were told not to eat from",
			"styleAttributes":{},
			"x":3100,
			"y":420,
			"width":460,
			"height":60
		},
		{
			"id":"9dd0885ebf3756ae",
			"type":"text",
			"text":"WE start in a garden",
			"styleAttributes":{},
			"x":2920,
			"y":-320,
			"width":260,
			"height":60
		},
		{
			"id":"a3a64c91460fab6b",
			"type":"text",
			"text":"What's so special about the garden?",
			"styleAttributes":{},
			"x":2920,
			"y":-240,
			"width":260,
			"height":60
		},
		{
			"id":"40becdd2084a4d56",
			"type":"text",
			"text":"The garden grows trees",
			"styleAttributes":{},
			"x":2920,
			"y":-160,
			"width":260,
			"height":60
		},
		{
			"id":"4803842fb8e53e32",
			"type":"text",
			"text":"And one of these trees is the tree of life",
			"styleAttributes":{},
			"x":2920,
			"y":-80,
			"width":260,
			"height":60
		},
		{
			"id":"9e0936b74ac4561e",
			"type":"text",
			"text":"Revelation 22",
			"styleAttributes":{},
			"x":2920,
			"y":1000,
			"width":130,
			"height":60
		},
		{
			"id":"5951706ad6bdacd9",
			"type":"text",
			"text":"The focus here is WHAT?",
			"styleAttributes":{},
			"x":2920,
			"y":1220,
			"width":220,
			"height":60
		},
		{
			"id":"6772086333e2d3a2",
			"type":"text",
			"text":"What's in the garden?",
			"styleAttributes":{},
			"x":3220,
			"y":-240,
			"width":260,
			"height":60
		},
		{
			"id":"889f0e909898c669",
			"type":"text",
			"text":"Very very special trees",
			"styleAttributes":{},
			"x":3220,
			"y":-160,
			"width":260,
			"height":60
		},
		{
			"id":"d76b69d328b09e48",
			"type":"text",
			"text":"The entire story of humankind is about our access to **the fruit of the tree of life**",
			"styleAttributes":{},
			"x":3220,
			"y":-90,
			"width":320,
			"height":80
		},
		{
			"id":"89cf854def0357f1",
			"type":"text",
			"text":"And the LORD God planted a garden in Eden, in the east, and there he put the man whom he had formed. And out of the ground the LORD God made to spring up every tree that is pleasant to the sight and good for food. The tree of life was in the midst of the garden, and the tree of the knowledge of good and evil.",
			"styleAttributes":{},
			"x":3100,
			"y":20,
			"width":640,
			"height":140
		},
		{
			"id":"8490a8672b2d9f1b",
			"type":"text",
			"text":"Genesis 2:8-9",
			"styleAttributes":{},
			"x":3780,
			"y":60,
			"width":160,
			"height":60
		},
		{
			"id":"3e1dab0339377d75",
			"type":"text",
			"text":"It ends in a garden",
			"styleAttributes":{},
			"x":3220,
			"y":-400,
			"width":260,
			"height":60
		},
		{
			"id":"d889ec3541ee80a4",
			"type":"text",
			"text":"WE end up back in a garden",
			"styleAttributes":{},
			"x":3220,
			"y":-320,
			"width":260,
			"height":60
		},
		{
			"id":"bdf1b95031d71f87",
			"type":"text",
			"text":"But what many Christians have never been told or noticed, is that the entire story of the Bible is about restoration back to a garden.",
			"styleAttributes":{},
			"x":3290,
			"y":-510,
			"width":370,
			"height":100
		},
		{
			"id":"db5fd5c440e3d8da",
			"type":"text",
			"text":"Roman Universalism / Christianity has done everything it can to conceal the truth from us. Even turning Yeshua into Satan.",
			"styleAttributes":{},
			"x":3440,
			"y":-680,
			"width":460,
			"height":120
		},
		{
			"id":"33b468b4de479bd8",
			"type":"text",
			"text":"Then the angel showed me the river of the water of life, bright as crystal, flowing from the throne of God and of the Lamb through the middle of the street of the city; also, on either side of the river, the tree of life with its twelve kinds of fruit, yielding its fruit each month. The leaves of the tree were for the healing of the nations. No longer will there be any curse.",
			"styleAttributes":{},
			"x":3100,
			"y":760,
			"width":640,
			"height":140
		},
		{
			"id":"b12c188df6fc69af",
			"type":"text",
			"text":"Revelation 22:1-3",
			"styleAttributes":{},
			"x":3780,
			"y":800,
			"width":180,
			"height":60
		},
		{
			"id":"4294cbb57bf2e04f",
			"type":"text",
			"text":"we are back in the garden",
			"styleAttributes":{},
			"x":3100,
			"y":920,
			"width":230,
			"height":60
		},
		{
			"id":"97aaf9eb43a69a53",
			"type":"text",
			"text":"we have access to the fruit of the tree of life",
			"styleAttributes":{},
			"x":3100,
			"y":1000,
			"width":360,
			"height":60
		},
		{
			"id":"f536f57ca02086e2",
			"type":"text",
			"text":"mankind has immortality",
			"styleAttributes":{},
			"x":3520,
			"y":1000,
			"width":240,
			"height":60
		},
		{
			"id":"475370a2f4d383c0",
			"type":"text",
			"text":"Relationship with God is restored",
			"styleAttributes":{},
			"x":3100,
			"y":1080,
			"width":280,
			"height":60
		},
		{
			"id":"9caaaf39c3412254",
			"type":"text",
			"text":"The restoration of all things",
			"styleAttributes":{},
			"x":3440,
			"y":1080,
			"width":260,
			"height":60
		},
		{
			"id":"c431d5fdee8fb287",
			"type":"text",
			"text":"Acts 3:21",
			"styleAttributes":{},
			"x":3780,
			"y":1080,
			"width":120,
			"height":60
		},
		{
			"id":"6102a58c1f6261d5",
			"type":"text",
			"text":"Mankind's access to the fruit of the tree of life / immortality",
			"styleAttributes":{},
			"x":3200,
			"y":1220,
			"width":320,
			"height":60
		},
		{
			"id":"793ce669001bd801",
			"type":"text",
			"text":"Now this is incredible. This is THE story that (BRACKETS) every other story. It should be THE central message of Christianity, but instead it's ignored. But there is SO MUCH more to this story.",
			"styleAttributes":{},
			"x":2920,
			"y":1320,
			"width":460,
			"height":120
		},
		{
			"id":"390717a22a497a06",
			"type":"text",
			"text":"And there's a reason you've never been told this, or the rest of the story.",
			"styleAttributes":{},
			"x":3440,
			"y":1300,
			"width":340,
			"height":60
		},
		{
			"id":"76002633ce3990ae",
			"type":"text",
			"text":"Buckle your seatbelts...",
			"styleAttributes":{},
			"x":3440,
			"y":1380,
			"width":220,
			"height":60
		},
		{
			"id":"1f5f112d0a395929",
			"type":"text",
			"text":"God curses the snake, Adam, and Eve",
			"styleAttributes":{},
			"x":3100,
			"y":500,
			"width":320,
			"height":60
		},
		{
			"id":"ae6333009b69417a",
			"type":"text",
			"text":"The BEGINNING and the END",
			"styleAttributes":{},
			"x":2600,
			"y":520,
			"width":260,
			"height":60
		},
		{
			"id":"1ad35c9b3fdad532",
			"type":"text",
			"text":"Now they are outside the garden",
			"styleAttributes":{},
			"x":3100,
			"y":580,
			"width":280,
			"height":60
		},
		{
			"id":"b18caef32130dead",
			"type":"text",
			"text":"Deprived of the fruit of the tree of life",
			"styleAttributes":{},
			"x":3100,
			"y":660,
			"width":320,
			"height":60
		},
		{
			"id":"61ec07795698e0c6",
			"type":"text",
			"text":"Mankind dies",
			"styleAttributes":{},
			"x":3460,
			"y":660,
			"width":160,
			"height":60
		},
		{
			"id":"7b4a39327a4f6973",
			"type":"text",
			"text":"The MAIN story of the Bible that you've never heard",
			"styleAttributes":{},
			"x":2600,
			"y":-700,
			"width":280,
			"height":55
		},
		{
			"id":"d96d893a439296ab",
			"type":"text",
			"text":"You need to think for yourself. Your pastor will tell you that everything I am saying here is wrong. So show it to them and ask them to resolve the theological dilemma. Be ready for some very inventive responses.",
			"styleAttributes":{},
			"x":2920,
			"y":-680,
			"width":480,
			"height":120
		},
		{
			"id":"a1c427ea2efcb567",
			"type":"text",
			"text":"In the beginning we have God in the garden with Adam and Eve.",
			"styleAttributes":{},
			"x":2920,
			"y":-500,
			"width":340,
			"height":80
		},
		{
			"id":"6bbc494c25fac423",
			"type":"text",
			"text":"The story that (BRACKETS) every other story of the entire Bible.",
			"styleAttributes":{},
			"x":2600,
			"y":-400,
			"width":260,
			"height":80
		},
		{
			"id":"d3356a493a990ca7",
			"type":"text",
			"text":"The story starts in a garden",
			"styleAttributes":{},
			"x":2920,
			"y":-400,
			"width":260,
			"height":60
		},
		{
			"id":"d681aa4d986855be",
			"type":"text",
			"text":"It's peculiar that the story that (brackets) the entire human condition in the Biblical text is completely unknown to the vast majority of Christians. How is that even possible? How is the story that provides context to everything else never preached in any Church? Never published in any of the thousands of new Christian books released each year. Hardly mentioned at all in nearly 2000 years of theological discourse?",
			"styleAttributes":{},
			"x":2920,
			"y":-1040,
			"width":740,
			"height":140
		},
		{
			"id":"6ba84fda749efa28",
			"type":"text",
			"text":"Chances are excellent you've never heard anything I'm about to show you. It's vital that you consider that deeply. If one of the single most important contexts of humanity that exists plainly in the Biblical text is not spoken of, you must ask yourself, \"WHY?\" Why has one of the single most important stories been all but erased?",
			"styleAttributes":{},
			"x":3700,
			"y":-1050,
			"width":600,
			"height":160
		},
		{
			"id":"24ad25d33691756d",
			"type":"text",
			"text":"And the answer is simple. If this story was known, the identity of the snake in the garden changes. And that, changes EVERYTHING.",
			"styleAttributes":{},
			"x":4340,
			"y":-1025,
			"width":420,
			"height":110
		},
		{
			"id":"d5e4c0c94b40234d",
			"type":"text",
			"text":"Roman Universalism / Christianity calls this event the Fall of Man, or the Original Sin.\n\nAccording to Christianity, the story goes like this...",
			"styleAttributes":{},
			"x":2920,
			"y":-840,
			"width":480,
			"height":120
		},
		{
			"id":"7f916b02b3628163",
			"type":"text",
			"text":"Adam & Eve lived in a garden with God. Satan as a snake comes along and tempts Eve to eat fruit from a tree God had specifically told them not to eat from. Eve eats the fruit, committing the first sin against God, leading to the introduction of death, and the fall of mankind into a sinful state.",
			"styleAttributes":{},
			"x":3440,
			"y":-854,
			"width":500,
			"height":148
		},
		{
			"id":"5841dcaa487ce654",
			"type":"text",
			"text":"We're going to dissect the story and in the process discover that the text simply doesn't say what Roman Universalism / Christianity claims it says at all, and that actually the story is quite different and incredibly more powerful than you've ever been told.",
			"styleAttributes":{},
			"x":3980,
			"y":-850,
			"width":440,
			"height":140
		},
		{
			"id":"1ee048b3c88f7543",
			"type":"text",
			"text":"The importance of CONTEXT",
			"styleAttributes":{},
			"x":5000,
			"y":80,
			"width":260,
			"height":60
		},
		{
			"id":"241d5c0a3e434c40",
			"type":"text",
			"text":"Pursuit of understanding",
			"styleAttributes":{},
			"x":6220,
			"y":-370,
			"width":220,
			"height":60
		},
		{
			"id":"83c2888543ccf7f0",
			"type":"text",
			"text":"Pursuit of legalism",
			"styleAttributes":{},
			"x":6220,
			"y":-180,
			"width":220,
			"height":60
		},
		{
			"id":"fbb34735a60a9d8e",
			"type":"text",
			"text":"\"You **search the Scriptures** because you think that **in them** you have eternal life; and it is they\nthat bear witness about me, yet you refuse to come to me that you may have life.\" - Yeshua",
			"styleAttributes":{},
			"x":6220,
			"y":-60,
			"width":380,
			"height":120
		},
		{
			"id":"5b4d06333513454a",
			"type":"text",
			"text":"This is what the religious leaders of his day were doing. Today Christians, are doing precisely what Yeshua warned the Pharisees against. Beware of Bible teachers that are \n**text**ualists not **context**ualists",
			"styleAttributes":{},
			"x":6220,
			"y":80,
			"width":380,
			"height":140
		},
		{
			"id":"44ac6bcd9198f136",
			"type":"text",
			"text":"John 5",
			"styleAttributes":{},
			"x":6640,
			"y":-30,
			"width":100,
			"height":60
		},
		{
			"id":"8737d1917441d4bf",
			"type":"text",
			"text":"Additionally, to look at not just the Bible alone but all possible ancient clues that could provide context to understanding the Biblical texts.",
			"styleAttributes":{},
			"x":6220,
			"y":285,
			"width":380,
			"height":100
		},
		{
			"id":"f806168e700e9048",
			"type":"text",
			"text":"When I approach the text, I seek to peel away the Roman Universalist metaphors and read the text plainly as it is written as much as possible. This can be hard for a Christian to do, because these metaphors are so deeply ingrained in the way we understand the text today.",
			"styleAttributes":{},
			"x":6220,
			"y":455,
			"width":420,
			"height":170
		},
		{
			"id":"e0f43d346b825fe4",
			"type":"text",
			"text":"But adding metaphor is adding potential for error. Removal of that added metaphor necessarily reduces the potential for error. That is what i seek to do, reduce error by returning to a plain reading of the text.",
			"styleAttributes":{},
			"x":6690,
			"y":468,
			"width":360,
			"height":145
		},
		{
			"id":"a7d714dcd9c51a5d",
			"type":"text",
			"text":"In semiotics, linguistics, sociology, and anthropology, **context** refers to those objects or entities which **surround** a focal event, in these disciplines typically a communicative event, of some kind. **Context is \"a frame that surrounds the event and provides resources for its appropriate interpretation\"**. It is thus a relative concept, only definable with respect to some focal event within a frame, not independently of that frame. From Wikipedia",
			"styleAttributes":{},
			"x":5480,
			"y":-425,
			"width":700,
			"height":170
		},
		{
			"id":"9470577bce2ea6ce",
			"type":"text",
			"text":"**Textualism** is a formalist theory in which the interpretation of the law is primarily based on the ordinary **meaning of the legal text**, where **no consideration is given** to non-textual sources, such as **intention** of the law when passed, the problem it was intended to remedy, or significant questions regarding the justice or rectitude of the law. From Wikipedia",
			"styleAttributes":{},
			"x":5480,
			"y":-220,
			"width":700,
			"height":140
		},
		{
			"id":"2144f34f0443837c",
			"type":"text",
			"text":"Those intent on deception become rigorous textualists because it provides **the easiest and most convincing method of deception**. If they can convince you a word means something specific, they will argue you must adhere to that definition, and most people just agree. But Yeshua directly address this practice.",
			"styleAttributes":{},
			"x":5720,
			"y":0,
			"width":460,
			"height":160
		},
		{
			"id":"43f17712e68cf038",
			"type":"text",
			"text":"What I am trying to do is pull back from a legalistic reading of the text to see the big picture by re-examining everything we've been taught by Rome and reading the text without 2000 years of added metaphor.",
			"styleAttributes":{},
			"x":5720,
			"y":260,
			"width":460,
			"height":150
		},
		{
			"id":"31c415e91095b5f1",
			"type":"text",
			"text":"I argue that what Rome has done is reframe the entire Biblical story and called their version of events, Roman Universalism, better known today as Christianity. Protestantism is no different. They agree on 99% of all foundational doctrines.",
			"styleAttributes":{},
			"x":5300,
			"y":260,
			"width":380,
			"height":150
		},
		{
			"id":"a338150e7020c04c",
			"type":"text",
			"text":"Yeshua used plenty of metaphor in the text, and that's fine, but it's not fine for Roman Universalism / Christianity to start adding their own metaphor to the text to reframe and often completely alter the meaning of important passages, often to their complete opposite.",
			"styleAttributes":{},
			"x":5660,
			"y":480,
			"width":520,
			"height":120
		},
		{
			"id":"eea14368f428c5c3",
			"type":"text",
			"text":"The importance of removing metaphor",
			"styleAttributes":{},
			"x":5300,
			"y":510,
			"width":320,
			"height":60
		},
		{
			"id":"a5f42ac53b788bc9",
			"type":"text",
			"text":"So let's explore some context...",
			"styleAttributes":{},
			"x":5300,
			"y":660,
			"width":280,
			"height":60
		},
		{
			"id":"2a9f253e93b37635",
			"type":"text",
			"text":"Context",
			"styleAttributes":{},
			"x":5300,
			"y":-370,
			"width":120,
			"height":60
		},
		{
			"id":"a847a12ee3b279e7",
			"type":"text",
			"text":"Textualism",
			"styleAttributes":{},
			"x":5300,
			"y":-180,
			"width":120,
			"height":60
		},
		{
			"id":"ba2e33bb2c6f516b",
			"type":"text",
			"text":"Textualism distorts the original meaning by sticking to **currently** known definitions of the **individual** **words** used we must seek out the **original context** if we are to **faithfully understand** what the author is actually saying.",
			"styleAttributes":{},
			"x":5300,
			"y":0,
			"width":380,
			"height":160
		},
		{
			"id":"516ba3b56460c7ed",
			"type":"text",
			"text":"The Tree of Life through the ancient world",
			"styleAttributes":{},
			"x":7440,
			"y":80,
			"width":240,
			"height":80
		},
		{
			"id":"98528073db762864",
			"type":"text",
			"text":"South America",
			"styleAttributes":{},
			"x":7940,
			"y":-90,
			"width":180,
			"height":60
		},
		{
			"id":"3155d1491026eecb",
			"type":"text",
			"text":"![[Pasted image 20261024184049.png]]",
			"styleAttributes":{},
			"x":8610,
