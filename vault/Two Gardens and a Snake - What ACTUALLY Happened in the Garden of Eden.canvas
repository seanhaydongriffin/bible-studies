			},
			"x":240,
			"y":20,
			"width":240,
			"height":60,
			"color":"5"
		},
		{
			"id":"60849814d7453587",
			"type":"text",
			"text":"**The Script**",
			"styleAttributes":{
				"shape":"pill",
				"textAlign":null,
				"border":"invisible"
			},
			"x":240,
			"y":140,
			"width":120,
			"height":60,
			"color":"5"
		},
		{
			"id":"138eb29309aedbf0",
			"type":"text",
