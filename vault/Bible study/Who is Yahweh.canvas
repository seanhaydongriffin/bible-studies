			"y":-120,
			"width":160,
			"height":60
		},
		{
			"id":"b46042e156a972fd",
			"type":"text",
			"text":"Yahweh is...",
			"styleAttributes":{},
			"x":-380,
			"y":-420,
			"width":160,
			"height":60
		},
		{
			"id":"e63e3622c0934d0d",
